APP_NAME=CampusBite API
ENVIRONMENT=development
DEBUG=false

# ---------------------------------------------------------------------------
# PostgreSQL (required). Pick your own values; nothing here is a real secret.
# Generate a password with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# NOTE: PostgreSQL stores these the first time its data volume is created. Changing
# the password later in this file does not change it inside an existing database.
# ---------------------------------------------------------------------------
POSTGRES_USER=campusbite
POSTGRES_PASSWORD=
POSTGRES_DB=campusbite

# localhost = running uvicorn on your own computer.
# Inside Docker Compose this is overridden to "db" automatically.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional full override (managed/cloud database). Leave it unset normally.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Connection pool (defaults are fine for development)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
DB_STARTUP_RETRIES=5
DB_STARTUP_RETRY_DELAY=2

# ---------------------------------------------------------------------------
# Auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=campusbite-api
BCRYPT_ROUNDS=12

# Public sign-up can only create CUSTOMER accounts. To create an owner or a delivery
# partner, the request must send this value in the X-Registration-Key header. Leave it
# empty to disable owner / delivery-partner registration entirely.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STAFF_REGISTRATION_KEY=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Simulated payments (no real gateway). success | decline | error
PAYMENT_SIMULATOR_OUTCOME=success
# Optional per-method overrides, e.g. wallet=decline,card=error
PAYMENT_SIMULATOR_METHOD_OUTCOMES=

# --- Automated order reminders (the `scheduler` service: python -m app.worker) ---
REMINDER_SCHEDULER_ENABLED=true
ORDER_REMINDER_CHECK_INTERVAL_SECONDS=60
ORDER_REMINDER_THRESHOLD_MINUTES=15

# --- AI order insights (OpenAI, called from the backend only) -------------------
# Put the real key ONLY in backend/.env (git-ignored). Empty = feature disabled (HTTP 503).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
# Per customer: at most N AI requests per sliding window (seconds)
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=3600
